# Copy to .env and fill in. The pipeline runs without any of these:
# without a key the uncertainty band is logged as `pending_human`.

# Provider-qualified model string for langchain's init_chat_model,
# e.g. "anthropic:claude-sonnet-5-5" or "openai:gpt-5".
LLM_MODEL=anthropic:claude-sonnet-5-5

# Set the key for the provider named in LLM_MODEL.
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
